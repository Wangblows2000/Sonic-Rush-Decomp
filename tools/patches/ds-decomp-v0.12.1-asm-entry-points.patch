     ExceptionTableEnd,
+    /// Project-defined absolute linker symbol (`link_time_const(NAME=0xVALUE)` in
+    /// relocs.txt), e.g. NitroSDK's SDK_SYS_STACKSIZE. Index into [`named_consts`].
+    Named(u16),
+}
+
+static NAMED: std::sync::Mutex<Vec<(String, u32)>> = std::sync::Mutex::new(Vec::new());
+
+/// All project-defined linker constants seen so far (name, value).
+pub fn named_consts() -> Vec<(String, u32)> {
+    NAMED.lock().unwrap().clone()
+}
+
+fn register_named(name: &str, value: u32) -> u16 {
+    let mut v = NAMED.lock().unwrap();
+    if let Some(i) = v.iter().position(|(n, _)| n == name) {
+        return i as u16;
+    }
+    v.push((name.to_string(), value));
+    (v.len() - 1) as u16
+}
+
+impl Default for LinkTimeConst {
+    fn default() -> Self {
+        Self::DtcmLo
+    }
 }
 
