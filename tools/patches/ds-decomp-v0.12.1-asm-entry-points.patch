diff --git a/cli/src/config/section.rs b/cli/src/config/section.rs
index fc97134..b746bd2 100644
--- a/cli/src/config/section.rs
+++ b/cli/src/config/section.rs
@@ -55,8 +55,11 @@ impl SectionExt for Section {
                     &[0xff, 0xf7, 0xfe, 0xff] // bl #0
                 }
                 RelocationKind::ArmBranch => {
-                    // R_ARM_PC24
-                    &[0xfe, 0xff, 0xff, 0xea] // b #0
+                    // R_ARM_PC24; keep the original condition code (conditional
+                    // branches into secondary entry points of hand-written asm)
+                    // 0xF is not a condition (BLX encoding space): fall back to AL.
+                    let cond = match code[offset + 3] & 0xf0 { 0xf0 => 0xe0, c => c };
+                    &[0xfe, 0xff, 0xff, cond | 0x0a] // b<cond> #0
                 }
                 RelocationKind::Load
                 | RelocationKind::OverlayId
